# Copy to .env.local for local dev, or set these in the Vercel project
# (Settings -> Environment Variables). All are optional — the site builds and
# runs without any of them; features degrade gracefully.

# Canonical site URL. Used for sitemap, canonical tags, JSON-LD, OG images.
# Set to your real domain in production. Defaults to https://toydistrictlosangeles.com.
NEXT_PUBLIC_SITE_URL=https://toydistrictlosangeles.com

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). When set, GA4 loads
# and fires store_view / lead_submit / store_inquiry events. Leave blank to
# disable analytics entirely.
NEXT_PUBLIC_GA_ID=

# Supabase — stores lead + per-store inquiry submissions. Server-side only
# (service role key; never exposed to the browser). Without these, the lead
# forms show the email fallback instead of saving. Apply supabase/schema.sql
# in the Supabase SQL editor first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
